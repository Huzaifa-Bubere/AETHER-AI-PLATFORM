# ─────────────────────────────────────────────────────────────────────────────
# AETHER — Docker Compose environment
#
# Copy this file to `.env` in the repository root and fill in real values.
# Docker Compose reads `.env` automatically. NEVER commit the real `.env`.
#
# Only variables that docker-compose.yml actually consumes are listed here.
# Per-application variables live in backend/.env.example, frontend/.env.example
# and ai-server/.env.example.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ────────────────────────────────────────────────────────────────
# Used by the bundled `mongodb` service AND handed to the backend container.
# Credits below are LOCAL DEVELOPMENT DEFAULTS ONLY — change them, and never use
# them in any deployed environment.
MONGODB_URI=mongodb://admin:password123@mongodb:27017/interview-platform?authSource=admin

# ── Auth (REQUIRED FOR CORE) ────────────────────────────────────────────────
# Two DIFFERENT long random values, e.g. `openssl rand -hex 48`.
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_SECRET

# ── AI (Gemini) ─────────────────────────────────────────────────────────────
# Optional: AI features degrade gracefully when this is empty.
GEMINI_API_KEY=
# Default used in source is gemini-3.6-flash. Set it to a model your key supports.
GEMINI_MODEL=gemini-3.6-flash

# ── Internal service secret (REQUIRED for backend ↔ ai-server) ──────────────
# A long random value shared by the Node backend and the FastAPI AI server.
# This is NOT a third-party API key. It is never exposed to the frontend.
PYTHON_AI_SERVER_API_KEY=CHANGE_ME_TO_A_RANDOM_INTERNAL_KEY

# ── Cloudinary (optional — media uploads) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Job providers (optional) ────────────────────────────────────────────────
# Adzuna is an official API and defaults to the India market.
ADZUNA_COUNTRY=in
# JobSpy is an OPTIONAL, disabled-by-default scraping source. Leave empty unless
# you have verified the source's terms. One source at a time.
JOBSPY_ENABLED=false
JOBSPY_SOURCES=
JOBSPY_RESULTS_PER_SOURCE=25
JOBSPY_TIMEOUT_MS=30000
JOBSPY_TIMEOUT_SECONDS=30

# ── Code execution safety ───────────────────────────────────────────────────
# true allows running candidate code on this host. Keep false unless you are
# deliberately testing local execution.
ALLOW_UNSAFE_LOCAL_CODE_EXECUTION=false

# ── Frontend ────────────────────────────────────────────────────────────────
# Path the browser uses to reach the API through the compose network.
VITE_API_BASE_URL=/api
