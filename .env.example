# ═══════════════════════════════════════════════════════════════════════════════
#  AETHER AI Platform — Root Environment File
#  
#  HOW TO USE:
#    1. Copy this file:   cp .env.example .env
#    2. Fill in the REQUIRED values marked below
#    3. Run:  docker compose up --build -d
#
#  NEVER commit the real .env to git.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Node Environment ────────────────────────────────────────────────────────
NODE_ENV=production

# ── Database (MongoDB) ──────────────────────────────────────────────────────
# Default uses the bundled MongoDB container — no changes needed for local dev.
MONGODB_URI=mongodb://admin:password123@mongodb:27017/interview-platform?authSource=admin

# ── Auth Secrets [REQUIRED] ─────────────────────────────────────────────────
# Generate with:  openssl rand -hex 48
# Must be two DIFFERENT long random strings.
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_SECRET_64_CHARS

# ── Google Gemini AI [REQUIRED for AI features] ─────────────────────────────
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Supported models: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash-exp
GEMINI_MODEL=gemini-1.5-flash

# ── Internal Service Secret [REQUIRED] ──────────────────────────────────────
# Shared secret between the Node backend and Python AI server.
# Generate with:  openssl rand -hex 48
PYTHON_AI_SERVER_API_KEY=CHANGE_ME_TO_A_RANDOM_INTERNAL_SECRET_KEY

# ── Cloudinary (optional — only needed for media upload/storage) ─────────────
# Sign up free at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Frontend API URL ─────────────────────────────────────────────────────────
# Leave as /api — Nginx routes /api/* to the backend automatically.
VITE_API_BASE_URL=/api

# ── Job Providers (optional) ─────────────────────────────────────────────────
ADZUNA_COUNTRY=in
JOBSPY_ENABLED=false
JOBSPY_SOURCES=
JOBSPY_RESULTS_PER_SOURCE=25
JOBSPY_TIMEOUT_MS=30000
JOBSPY_TIMEOUT_SECONDS=30

# ── Code Execution Safety ────────────────────────────────────────────────────
# Keep false unless you deliberately want to test local code execution.
ALLOW_UNSAFE_LOCAL_CODE_EXECUTION=false
