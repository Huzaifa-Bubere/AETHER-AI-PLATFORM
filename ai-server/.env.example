# ─────────────────────────────────────────────────────────────────────────────
# AETHER — AI server (FastAPI) environment
#
# Copy to `ai-server/.env`. main.py loads this file explicitly, so it lives in
# `ai-server/`. NEVER commit it.
#
# Only variables read by ai-server/src are listed (verified).
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development
PORT=8000

FRONTEND_URL=http://localhost:5174
BACKEND_URL=http://localhost:5001

# Shared secret with the Node backend. Must equal the backend's
# PYTHON_AI_SERVER_API_KEY. Long random value; never exposed to the browser.
PYTHON_AI_SERVER_API_KEY=CHANGE_ME_TO_A_RANDOM_INTERNAL_KEY

# Google Gemini (optional — media/NLP features report unavailable without it).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
