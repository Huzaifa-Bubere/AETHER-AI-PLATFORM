# ─────────────────────────────────────────────────────────────────────────────
# AETHER — Backend (Node.js / Express) environment
#
# Copy to `backend/.env`. Loaded by backend/src/config/environment.ts, so the
# file must sit in `backend/`, not the repository root. NEVER commit it.
#
# Every variable below was verified to be read in backend/src.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5001

# ── REQUIRED FOR CORE — the server will not work correctly without these ────
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE
# Legacy alias accepted by the seed scripts (MONGO_URI). Prefer MONGODB_URI.
MONGO_URI=
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5174
BACKEND_URL=http://localhost:5001

# ── Redis (cache / sockets / locks) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI server (internal shared secret) ──────────────────────────────────────
PYTHON_AI_SERVER_URL=http://localhost:8000
# Long random value; must match ai-server's PYTHON_AI_SERVER_API_KEY.
PYTHON_AI_SERVER_API_KEY=CHANGE_ME_TO_A_RANDOM_INTERNAL_KEY

# ── Google Gemini (optional — AI features degrade gracefully without it) ────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# 429 (rate limit/quota) and 503 (upstream overload) are transient, so requests are
# retried with exponential backoff before a feature reports the AI as unavailable.
# AI_REQUEST_ATTEMPTS=1 means "one call, fail fast" (also disables fallback models).
AI_REQUEST_ATTEMPTS=3
# Total budget for RETRIES, in ms. The first attempt keeps each caller's own
# timeout, so worst case is (caller timeout + this budget).
AI_RETRY_BUDGET_MS=20000
# Base backoff before the first retry, in ms (doubles per attempt, plus jitter).
AI_RETRY_BASE_MS=400
# Comma-separated models tried when the configured model stays rate-limited (429),
# overloaded (503), or unknown (404). Set to empty to disable. A fallback must be
# able to FINISH inside AI_RETRY_BUDGET_MS, so verify latency, not just availability:
#   curl -s -o /dev/null -w "%{http_code} %{time_total}s\n" \
#     -X POST "https://generativelanguage.googleapis.com/v1beta/models/$M:generateContent" \
#     -H "x-goog-api-key: $GEMINI_API_KEY" -H "Content-Type: application/json" \
#     --data '{"contents":[{"role":"user","parts":[{"text":"Return JSON only: {\"text\":\"ok\"}"}]}],"generationConfig":{"responseMimeType":"application/json"}}'
# Embeddings never fall back — vectors from a different embedding model are not
# comparable, and mixing them would corrupt similarity search.
AI_FALLBACK_MODELS=gemini-3.1-flash-lite

# ── Cloudinary (optional — media/upload storage) ────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email / SMTP (optional — verification + reset emails) ───────────────────
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=AETHER

# ── Stripe (optional — payments/subscriptions) ──────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
# Dev-only escape hatch: lets an admin activate a plan without a Stripe webhook.
ALLOW_MANUAL_PLAN_ACTIVATION=false

# ── Career learning (optional — YouTube recommendations) ────────────────────
YOUTUBE_API_KEY=
YOUTUBE_REFRESH_DAYS=30

# ── Job providers ───────────────────────────────────────────────────────────
# Adzuna official API (optional). Without keys the provider reports
# NOT CONFIGURED and ingestion continues with the other providers.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
JOOBLE_ENABLED=false
JOOBLE_API_KEY=
JOOBLE_API_BASE_URL=https://jooble.org/api/
# RemoteOK is keyless and on by default; set false to disable it.
REMOTEOK_ENABLED=true
# Scheduled refresh interval in minutes (never refreshed per page request).
JOB_REFRESH_INTERVAL_MINUTES=360
JOB_PROVIDER_TIMEOUT_MS=20000
# First-startup ingestion: when the job store is EMPTY and a provider IS
# configured, one refresh runs at boot instead of waiting a full interval.
# This budget is how long startup is willing to wait for it; the refresh keeps
# running in the background if it overruns, and startup is never blocked.
JOB_STARTUP_INGESTION_BUDGET_MS=25000
JOB_ALERT_MIN_RELEVANCE=70
# Optional JobSpy source (see job-provider-service/.env.example).
JOBSPY_ENABLED=false
JOBSPY_SERVICE_URL=http://localhost:8010
JOBSPY_SOURCES=
JOBSPY_RESULTS_PER_SOURCE=25
JOBSPY_TIMEOUT_MS=30000

# ── Interview integrity ─────────────────────────────────────────────────────
# Authoritative warning limit. Reaching it auto-submits the assessment. Read by
# backend/src/models/IntegrityEvent.ts.
#
# NOTE, stated deliberately: the per-EVENT thresholds (3 s eye closure, 4 s
# attention deviation, 5 s face missing, 2 s multiple faces, per-event cooldowns)
# are NOT environment variables, because they are enforced by the client rules
# engine in frontend/src/app/features/integrity/rules/integrityRules.ts — one
# source of truth that is unit-tested without a camera. The backend independently
# enforces the warning LIMIT and a per-event cooldown
# (backend/src/integrity/integrity.service.ts) so a misbehaving client cannot
# spam warnings. Adding unused variables here would imply enforcement that does
# not exist.
INTEGRITY_MAX_WARNINGS=5

# Group Discussion
GD_MAX_DURATION_MINUTES=15
GD_MAX_AI_PARTICIPANTS=3

# ── Code execution ──────────────────────────────────────────────────────────
CODE_EXECUTION_SERVICE=piston
PISTON_URL=https://emkc.org/api/v2/piston
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_HOST=
# Keep false unless deliberately running candidate code on this host.
ALLOW_UNSAFE_LOCAL_CODE_EXECUTION=false
# Local JDK path used by the optional local runner.
JAVA_HOME=
COMPLEXITY_CONFIDENCE_THRESHOLD=0.6
# Bounds for the code-execution trace recorder.
TRACE_MAX_STEPS=2000
TRACE_MAX_BYTES=524288
TRACE_TIMEOUT_MS=15000

# ── Uploads ─────────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760
SUPPORTED_FILE_TYPES=pdf,doc,docx,txt

# ── RAG (retrieval-augmented assessments) ───────────────────────────────────
RAG_VECTOR_MODE=exact
RAG_VECTOR_INDEX=aether_knowledge
RAG_MIN_SIMILARITY=0.7
RAG_ALLOWED_HOSTS=
QUESTION_REPEAT_COOLDOWN_DAYS=30

# ── Interviews ──────────────────────────────────────────────────────────────
INTERVIEW_MAX_FOLLOW_UPS=2

# ── Misc ────────────────────────────────────────────────────────────────────
DNS_SERVERS=

# ── Seed overrides (scripts only) ───────────────────────────────────────────
# Optional: point seed scripts at a different database than the app.
SEED_MONGODB_URI=
# LOCAL DEVELOPMENT ONLY. Create an admin and change the password immediately.
SEED_ADMIN_EMAIL=admin@aether.local
SEED_ADMIN_PASSWORD=CHANGE_ME
