# ─────────────────────────────────────────────────────────────────────────────
# AETHER — Backend (Node.js / Express) environment
#
# Copy to `backend/.env`. Loaded by backend/src/config/environment.ts, so the
# file must sit in `backend/`, not the repository root. NEVER commit it.
#
# Every variable below was verified to be read in backend/src.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5001

# ── REQUIRED FOR CORE — the server will not work correctly without these ────
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE
# Legacy alias accepted by the seed scripts (MONGO_URI). Prefer MONGODB_URI.
MONGO_URI=
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_RANDOM_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5174
BACKEND_URL=http://localhost:5001

# ── Redis (cache / sockets / locks) ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI server (internal shared secret) ──────────────────────────────────────
PYTHON_AI_SERVER_URL=http://localhost:8000
# Long random value; must match ai-server's PYTHON_AI_SERVER_API_KEY.
PYTHON_AI_SERVER_API_KEY=CHANGE_ME_TO_A_RANDOM_INTERNAL_KEY

# ── Google Gemini (optional — AI features degrade gracefully without it) ────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── Cloudinary (optional — media/upload storage) ────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Email / SMTP (optional — verification + reset emails) ───────────────────
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM_NAME=AETHER

# ── Stripe (optional — payments/subscriptions) ──────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
# Dev-only escape hatch: lets an admin activate a plan without a Stripe webhook.
ALLOW_MANUAL_PLAN_ACTIVATION=false

# ── Career learning (optional — YouTube recommendations) ────────────────────
YOUTUBE_API_KEY=
YOUTUBE_REFRESH_DAYS=30

# ── Job providers ───────────────────────────────────────────────────────────
# Adzuna official API (optional). Without keys the provider reports
# NOT CONFIGURED and ingestion continues with the other providers.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
# RemoteOK is keyless and on by default; set false to disable it.
REMOTEOK_ENABLED=true
# Scheduled refresh interval in minutes (never refreshed per page request).
JOB_REFRESH_INTERVAL_MINUTES=360
JOB_PROVIDER_TIMEOUT_MS=20000
JOB_ALERT_MIN_RELEVANCE=70
# Optional JobSpy source (see job-provider-service/.env.example).
JOBSPY_ENABLED=false
JOBSPY_SERVICE_URL=http://localhost:8010
JOBSPY_SOURCES=
JOBSPY_RESULTS_PER_SOURCE=25
JOBSPY_TIMEOUT_MS=30000

# ── Code execution ──────────────────────────────────────────────────────────
CODE_EXECUTION_SERVICE=piston
PISTON_URL=https://emkc.org/api/v2/piston
JUDGE0_URL=
JUDGE0_API_KEY=
JUDGE0_HOST=
# Keep false unless deliberately running candidate code on this host.
ALLOW_UNSAFE_LOCAL_CODE_EXECUTION=false
# Local JDK path used by the optional local runner.
JAVA_HOME=
COMPLEXITY_CONFIDENCE_THRESHOLD=0.6
# Bounds for the code-execution trace recorder.
TRACE_MAX_STEPS=2000
TRACE_MAX_BYTES=524288
TRACE_TIMEOUT_MS=15000

# ── Uploads ─────────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760
SUPPORTED_FILE_TYPES=pdf,doc,docx,txt

# ── RAG (retrieval-augmented assessments) ───────────────────────────────────
RAG_VECTOR_MODE=exact
RAG_VECTOR_INDEX=aether_knowledge
RAG_MIN_SIMILARITY=0.7
RAG_ALLOWED_HOSTS=
QUESTION_REPEAT_COOLDOWN_DAYS=30

# ── Interviews ──────────────────────────────────────────────────────────────
INTERVIEW_MAX_FOLLOW_UPS=2

# ── Misc ────────────────────────────────────────────────────────────────────
DNS_SERVERS=

# ── Seed overrides (scripts only) ───────────────────────────────────────────
# Optional: point seed scripts at a different database than the app.
SEED_MONGODB_URI=
# LOCAL DEVELOPMENT ONLY. Create an admin and change the password immediately.
SEED_ADMIN_EMAIL=admin@aether.local
SEED_ADMIN_PASSWORD=CHANGE_ME
