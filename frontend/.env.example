# ─────────────────────────────────────────────────────────────────────────────
# AETHER — Frontend (Vite) environment
#
# Copy to `frontend/.env` for manual local development.
#
# SECURITY: Vite only exposes variables prefixed with `VITE_`. Everything else is
# ignored by the build — but do NOT keep backend secrets in this file anyway.
# Never put GEMINI_API_KEY, MONGODB_URI, JWT secrets, STRIPE_SECRET_KEY or
# CLOUDINARY secrets here: any VITE_ variable is shipped to the browser.
#
# The source reads exactly ONE variable (verified): VITE_API_BASE_URL.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL the browser uses to reach the backend API.
#   manual local dev:  http://localhost:5001
#   behind docker/nginx: /api
VITE_API_BASE_URL=http://localhost:5001
