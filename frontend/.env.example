# ─────────────────────────────────────────────────────────────────────────────
# AETHER — Frontend (Vite) environment
#
# Copy to `frontend/.env` for manual local development.
#
# SECURITY: Vite only exposes variables prefixed with `VITE_`. Everything else is
# ignored by the build — but do NOT keep backend secrets in this file anyway.
# Never put GEMINI_API_KEY, MONGODB_URI, JWT secrets, STRIPE_SECRET_KEY or
# CLOUDINARY secrets here: any VITE_ variable is shipped to the browser.
#
# The source reads VITE_API_BASE_URL plus the two MediaPipe asset variables below.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL the browser uses to reach the backend API.
#   manual local dev:  http://localhost:5001
#   behind docker/nginx: /api
VITE_API_BASE_URL=http://localhost:5001

# ── MediaPipe (interview eye tracking) ──
# These are ASSET URLs, never credentials. They default to Google's public
# distribution for the exact @mediapipe/tasks-vision version pinned in
# package.json (@mediapipe/tasks-vision@0.10.17), so the defaults work with no
# configuration at all. A self-hosted deployment can point them at its own copies
# so an offline assessment never depends on a third-party CDN.
#
# The wasm directory that ships inside node_modules/@mediapipe/tasks-vision/wasm
# can be copied to your web root and served from there:
#   cp -r node_modules/@mediapipe/tasks-vision/wasm public/mediapipe/wasm
VITE_MEDIAPIPE_WASM_BASE=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.17/wasm
VITE_FACE_LANDMARKER_MODEL_URL=https://storage.googleapis.com/mediapipe-models/face_landmarker/face_landmarker/float16/1/face_landmarker.task
