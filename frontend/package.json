{
  "name": "aether-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "npm run typecheck && node scripts/build.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test:integrity": "node scripts/run-integrity-tests.mjs",
    "resume:pdf-samples": "esbuild scripts/render-sample-resume.tsx --bundle --platform=node --format=cjs --outfile=tmp/render-sample-resume.cjs --external:@react-pdf/renderer && node tmp/render-sample-resume.cjs",
    "resume:pdf-verify": "node scripts/verify-resume-pdf.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-accordion": "1.2.3",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-slot": "1.1.2",
    "@react-pdf/renderer": "^4.9.0",
    "@react-three/drei": "^9.96.1",
    "@react-three/fiber": "^8.15.19",
    "axios": "^1.6.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "^11.0.3",
    "html2canvas": "^1.4.1",
    "lucide-react": "0.487.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.13.0",
    "recharts": "^2.15.2",
    "tailwind-merge": "3.2.0",
    "three": "^0.170.0",
    "tw-animate-css": "1.3.8",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/node": "^20.10.4",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "tailwindcss": "4.1.12",
    "typescript": "^5.3.3",
    "vite": "6.4.3"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
