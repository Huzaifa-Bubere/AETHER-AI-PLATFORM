# JobSpy is OFF by default. No source is queried until you opt in.
# Deliberately NOT enabled for every site at once (spec §11, §12).
JOBSPY_ENABLED=false

# Comma-separated allow-list. Only these are ever queried.
# Start with ONE source, verify its terms and stability, then add more.
JOBSPY_SOURCES=naukri

# Node backend location of this service.
#   local docker-compose: http://localhost:8010
#   from inside Docker:   http://job-provider-service:8010
JOBSPY_SERVICE_URL=http://localhost:8010

JOBSPY_RESULTS_PER_SOURCE=25
JOBSPY_TIMEOUT_MS=30000
JOBSPY_REFRESH_ENABLED=false
